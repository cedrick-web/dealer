# Copy to .env and replace every CHANGE_ME value before starting containers.
# Use a long alphanumeric Mongo password to avoid URI-escaping mistakes.
MONGO_ROOT_USERNAME=dealer_admin
MONGO_ROOT_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_ALPHANUMERIC_PASSWORD
MONGO_DATABASE=dealer
JWT_SECRET=CHANGE_ME_AT_LEAST_64_RANDOM_CHARACTERS
API_PORT=8080
# Origin of the web app as seen by the API. Must match the deployed frontend origin.
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8080
# Optional bootstrap admin, created only when both are supplied and the email is unused.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_14_CHARS_MIN
